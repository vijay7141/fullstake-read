# Environment Variables for WhatsApp CRM

# Database Connection (SQLite by default for zero-setup local dev; switch to PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# Admin Authentication Secret (Used for signing admin JWT sessions)
JWT_SECRET="whatsapp-crm-super-secret-jwt-key-change-this-in-production-998877"

# Meta WhatsApp Business Cloud API Configuration
# Get these from Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Meta Webhook Configuration
# Choose any secure string and match it in Meta Developer Dashboard -> WhatsApp -> Configuration -> Webhook
WHATSAPP_VERIFY_TOKEN="whatsapp_crm_verify_token_secure_2025"

# Meta App Secret (Optional but recommended: used to verify X-Hub-Signature-256 for webhook security)
WHATSAPP_APP_SECRET=""

# Public Application URL (used for webhooks and webhook simulator)
NEXT_PUBLIC_APP_URL="http://localhost:3000"