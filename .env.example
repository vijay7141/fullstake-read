# ==========================================
# WhatsApp CRM Environment Variables Example
# ==========================================

# 1. Database Connection
# SQLite for local development: "file:./dev.db"
# PostgreSQL for production (Supabase / Neon / Railway / AWS RDS):
# DATABASE_URL="postgresql://username:password@localhost:5432/whatsapp_crm?schema=public"
DATABASE_URL="file:./dev.db"

# 2. Authentication Secret (Replace with a strong random 32+ character string in production)
JWT_SECRET="replace-with-a-very-long-random-secret-key-32-chars-minimum"

# 3. Meta WhatsApp Business Cloud API Credentials
# Found under: Meta Developer Console -> Your App -> WhatsApp -> API Setup
# Permanent System User token recommended for production
WHATSAPP_ACCESS_TOKEN="EAAG..."
# Found in API Setup -> Step 1 "Phone number ID"
WHATSAPP_PHONE_NUMBER_ID="100000000000001"
# Found in API Setup -> Step 1 "WhatsApp Business Account ID"
WHATSAPP_BUSINESS_ACCOUNT_ID="200000000000002"

# 4. Meta Webhook Security Configuration
# Set any secret string here, and enter the EXACT SAME string in Meta App Dashboard -> WhatsApp -> Configuration -> Webhook -> Verify Token
WHATSAPP_VERIFY_TOKEN="your_custom_webhook_verification_token"

# 5. Meta App Secret (Optional but recommended for HMAC SHA-256 webhook payload validation)
# Found under: Meta Developer Console -> App settings -> Basic -> App secret
WHATSAPP_APP_SECRET=""

# 6. Public App URL (Used for webhook URL generation and callback links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
